// Next TODO 集中配置。
// 替换成自己的标识时，只改这个文件。
// NextUpShared/AppIdentity.swift 里的 placeholder 必须与这里一致，测试会校验。

NEXTUP_APP_BUNDLE_ID = com.binyu.nextupapp
NEXTUP_WIDGET_BUNDLE_ID = com.binyu.nextupapp.widget
NEXTUP_SHARED_BUNDLE_ID = com.binyu.nextupapp.shared
NEXTUP_TESTS_BUNDLE_ID = com.binyu.nextupapp.tests
NEXTUP_APP_GROUP_ID = 372XT34PQJ.com.binyu.nextupapp
NEXTUP_URL_SCHEME = nextup

MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 5.0
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 2
PRODUCT_BUNDLE_IDENTIFIER = $(NEXTUP_APP_BUNDLE_ID)

// 上架用 App Group。主应用和小组件各自沙盒，不能再写主目录。
NEXTUP_APP_ENTITLEMENTS = NextUpApp/NextUpApp.entitlements
NEXTUP_WIDGET_ENTITLEMENTS = NextUpWidget/NextUpWidget.entitlements
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = 372XT34PQJ
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 佳林 李
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_PREVIEWS = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDevelopmentRegion = en
INFOPLIST_KEY_CFBundleDisplayName = Next TODO
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
APPLICATION_EXTENSION_API_ONLY = NO
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
SUPPORTS_MACCATALYST = NO
